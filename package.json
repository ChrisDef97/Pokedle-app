{
  "name": "pokedle-desktop",
  "version": "0.1.0",
  "description": "Clon de Pokedle como app de escritorio, 100% offline",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "Christian",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "build": {
    "appId": "com.christian.pokedledesktop",
    "productName": "Pokedle Desktop",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
